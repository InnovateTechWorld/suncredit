{
  "name": "suncredit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "reseed": "node --disable-warning=ExperimentalWarning -e \"import('./server/seed/seed.js').then(m=>m.reseed({})).then(s=>{console.log(JSON.stringify(s,null,1));process.exit(0)})\"",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "sunbox": "node --disable-warning=ExperimentalWarning scripts/sunbox.js",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir .wrangler/dry",
    "test:sqljs": "DB_DRIVER=sqljs node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "dev:worker": "wrangler dev"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/figtree": "^5.2.10",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "express": "^5.2.1",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "wrangler": "^4.160.0"
  }
}