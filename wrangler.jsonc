{
  // SunCredit on Cloudflare: a Worker in front of one Container running the Node app.
  // Needs a Workers Paid plan (Containers) and Docker running locally when you deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suncredit",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "SunCreditContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "SunCreditContainer", "name": "SUNCREDIT" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SunCreditContainer"] }],
  "vars": {
    // "1" lists the seeded demo accounts on the sign-in page. Set "0" to hide them.
    "DEMO_LOGIN_HINTS": "1"
  }
}
